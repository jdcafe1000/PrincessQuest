# Always re-check the app itself, so a deploy shows up straight away.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sync.js
  Cache-Control: no-cache
/api/*
  Cache-Control: no-store

# Icons change rarely and are content-addressed by name.
/icon-*.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
