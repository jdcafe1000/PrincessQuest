{
  // Must match the Worker in the dashboard, or a deploy creates a second one
  // and the custom domain stays on the old Worker.
  "name": "princessquest",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",

  // Everything in public/ is served directly. The Worker in src/index.js only
  // runs for paths with no matching file, which is how /api/state reaches it.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "observability": { "enabled": true },

  // The shared chart lives here. Keep this binding in this file rather than in
  // the dashboard's "Add a binding" dialog: this Worker deploys with
  // `wrangler deploy`, which treats this file as the source of truth and drops
  // any binding that is not in it.
  "kv_namespaces": [
    { "binding": "CHART", "id": "a3f18f57cece45948dc2ff7802a74ee9" }
  ]
}
